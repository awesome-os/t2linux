#!ipxe
# Awesome-OS Linux v11 — Stateless HTTPS Netboot (Zero Disk Required)
# Chainload from any bare-metal UEFI/PXE/Proxmox/Hyper-V host:
#   chain https://awesome-os.com/netboot/boot.ipxe

echo ============================================================
echo   Awesome-OS Linux v11 — Stateless Netboot (B8G_ABI_MAGIC_V3)
echo   Mode: RAM tmpfs v11 CAS (install to local disk later)
echo ============================================================

set base https://github.com/awesome-os/t2linux/releases/latest/download

kernel ${base}/vmlinuz-x86_64 initrd=initramfs-x86_64.cpio.zst console=tty0 console=ttyS0,115200 awesome.netboot=1 || goto failed
initrd ${base}/initramfs-x86_64.cpio.zst || goto failed
boot || goto failed

:failed
echo [AWESOME-OS] Netboot failed — dropping to iPXE shell
shell
