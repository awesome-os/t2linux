# T2Linux Optional Kernel Config Fragment — VirtIO-GPU Venus (Vulkan / OpenGL ES VM Acceleration)
# Compatible with QEMU (virglrenderer + venus=true), crosvm, libkrun / krunkit, and atomickrisp.
#
# Merge into a custom kernel build via:
#   scripts/kconfig/merge_config.sh .config config/virtio-gpu-venus.config

CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_VIRTIO_GPU_KMS=y
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_UDMABUF=y
CONFIG_SYNC_FILE=y
