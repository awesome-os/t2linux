{
  "schema": "awesome-os.system-definition.v1",
  "abiMagic": "0x33564742",
  "systemUri": "system://local/appliance/awesome-os-linux",
  "casRoot": "/var/lib/b8g/cas",
  "v11Registry": "repository://github.com/awesome-os/holo-v11@main",
  "resources": [
    {
      "uri": "system://local/terminal-app/coreutils",
      "from": "repository://github.com/awesome-os/coreutils@main",
      "tags": ["terminal-app", "local"]
    },
    {
      "uri": "system://local/monitor/desktop-omarchy?kvm=2",
      "from": "repository://github.com/awesome-os/desktop-omarchy@main",
      "tags": ["monitor", "keyboard", "local"]
    },
    {
      "uri": "system://local/device/holo-kvm-switch",
      "from": "repository://github.com/awesome-os/sectium@main",
      "tags": ["device", "monitor", "keyboard", "local"]
    },
    {
      "uri": "system://local/appliance/rack",
      "from": "repository://github.com/awesome-os/awesome-os-desktop@main",
      "tags": ["appliance", "browser-app", "local"]
    }
  ]
}
